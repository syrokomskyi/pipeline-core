{
  "name": "@syrokomskyi/pipeline-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.lib.json",
    "lint": "pnpm exec eslint src --ext .ts",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm exec tsc -p tsconfig.lib.json --noEmit",
    "upgrade-packages": "pnpm up --latest",
    "compass:annotate": "code-compass annotate --root .",
    "compass:migrate": "code-compass migrate --root .",
    "compass:inventory": "code-compass inventory --root .",
    "compass:validate": "code-compass validate --root .",
    "compass": "code-compass validate --root .",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@syrokomskyi/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./phase": {
      "@syrokomskyi/source": "./src/lib/pipeline-phase.ts",
      "types": "./src/lib/pipeline-phase.ts",
      "import": "./dist/lib/pipeline-phase.js",
      "default": "./dist/lib/pipeline-phase.js"
    },
    "./step": {
      "@syrokomskyi/source": "./src/lib/pipeline-step.ts",
      "types": "./src/lib/pipeline-step.ts",
      "import": "./dist/lib/pipeline-step.js",
      "default": "./dist/lib/pipeline-step.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@syrokomskyi/code-compass": "workspace:*",
    "@wgogol/changelog-live": "workspace:*",
    "eslint": "~10.7.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  }
}
